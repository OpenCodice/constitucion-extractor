{
  "name": "scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Solo corre por cron: no expone ninguna URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // El mismo que TIC en worker.js (lo comprueba worker.test.mjs).
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}
