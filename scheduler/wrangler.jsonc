{
  "name": "scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Solo corre por cron: no expone ninguna URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Deben coincidir con VIGILANCIAS y VIGILANTE en worker.js.
    "crons": ["0 9 * * MON", "0 13 * * MON", "30 15 * * *"]
  },
  "observability": { "enabled": true }
}
